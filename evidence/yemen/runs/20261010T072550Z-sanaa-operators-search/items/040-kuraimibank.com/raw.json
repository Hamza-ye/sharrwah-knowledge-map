u0627\u0643 \u0628\u0627\u0644\u062e\u062f\u0645\u0629 \u0639\u0628\u0631 \u0623\u062d\u062f \u0641\u0631\u0648\u0639 \u0627\u0644\u0628\u0646\u0643.<\/span><\/span><\/span><\/p>","service_request_link":null,"main_service":{"id":5,"title":"\u0627\u0645 \u0641\u0644\u0648\u0633","category_id":null,"category_title":null,"main_target_id":null,"main_target_title":null,"related_categories":[]},"service_advantages":[],"faqs":[{"id":36,"question":"\u0646\u0633\u064a\u062a \u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0643\u064a\u0641 \u064a\u0645\u0643\u0646\u0646\u064a \u0627\u0633\u062a\u0639\u0627\u062f\u062a\u0647\u0627\u061f","answer":"\u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633\u060c \u064a\u0631\u062c\u0649 \u0627\u062a\u0628\u0627\u0639 \u0627\u0644\u062e\u0637\u0648\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629:\r\n- \u0645\u0646 \u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0623\u0645\u0627\u0645\u064a\u0629 \u0642\u0645 \u0628\u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0646\u0633\u064a\u062a \u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631.\r\n- \u0623\u062f\u062e\u0644 \u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.\r\n- \u0623\u062f\u062e\u0644 \u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0628\u0645\u062d\u0641\u0638\u0629 \u0627\u0645 \u0641\u0644\u0648\u0633.\r\n- \u0623\u062f\u062e\u0644 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f \u0648\u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0648\u0627\u0641\u0642.\r\n\r\n\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 ^_^"},{"id":37,"question":"\u0645\u0627\u0647\u064a \u0645\u062d\u0641\u0638\u0629 \u0627\u0645 \u0641\u0644\u0648\u0633 \u061f","answer":"\u0645\u062d\u0641\u0638\u0629 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0647\u064a \u0623\u0648\u0644 \u0645\u062d\u0641\u0638\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u064a\u0645\u0646 \u062a\u0645 \u062a\u062f\u0634\u064a\u0646\u0647\u0627 \u0641\u064a \u0639\u0627\u0645 2016 \u0645\u0646 \u0628\u0646\u0643 \u0627\u0644\u0643\u0631\u064a\u0645\u064a \u0644\u0644\u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0623\u0635\u063a\u0631 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a. \u062a\u0642\u062f\u0645 \u062d\u0632\u0645\u0629 \u0648\u0627\u0633\u0639\u0629 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u0645\u0635\u0631\u0641\u064a\u0629 \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0646\u0648\u0639\u064a\u0629 \u062a\u0644\u0628\u064a \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629. \u0648\u062a\u0639\u062a\u0628\u0631 \u0645\u062d\u0641\u0638\u0629 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0627\u0644\u0623\u0643\u0628\u0631 \u0648\u0627\u0644\u0623\u0648\u0633\u0639 \u0627\u0646\u062a\u0634\u0627\u0631\u0627 \u0641\u064a \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0627\u062a \u0627\u0644\u064a\u0645\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0644\u0627\u0631\u064a\u0627\u0641 \u0639\u0628\u0631 \u0634\u0628\u0643\u0629 \u0643\u0628\u064a\u0631\u0629 \u0648\u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0623\u062f\u0627\u0621 \u0645\u0646 \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0648\u0646\u0642\u0627\u0637 \u0627\u0644\u062e\u062f\u0645\u0629. \r\n\r\n\u0648\u0644\u0645\u0639\u0631\u0641\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0623\u0643\u062b\u0631 \u0639\u0646 \u0627\u0644\u062e\u062f\u0645\u0629 \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0647\u0646\u0627 \"\u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0645 \u0641\u0644\u0648\u0633 | \u0628\u0646\u0643 \u0627\u0644\u0643\u0631\u064a\u0645\u064a \u0644\u0644\u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0623\u0635\u063a\u0631 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a (kuraimibank.com) \"\r\n\u0623\u0648 \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 ^_^"},{"id":38,"question":"\u0643\u064a\u0641 \u0623\u062d\u0635\u0644 \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0627\u0645 \u0641\u0644\u0648\u0633\u061f","answer":"\u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0645\u0627 \u0639\u0644\u064a\u0643 \u0625\u0644\u0627 \u0623\u0646: \r\n- \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u0648\u062c\u0647 \u0625\u0644\u0649 \u0623\u0642\u0631\u0628 \u0648\u0643\u064a\u0644 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0645\u0639 \u0625\u062d\u0636\u0627\u0631 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u0623\u0635\u0644 \u0623\u0648 \u0627\u0644\u0639\u0627\u0626\u0644\u064a\u0629 \u0627\u0644\u0623\u0635\u0644 \u0623\u0648 \u062c\u0648\u0627\u0632 \u0633\u0641\u0631 \u0633\u0627\u0631\u064a \u0627\u0644\u0645\u0641\u0639\u0648\u0644. \r\n- \u062a\u0639\u0628\u0626\u0629 \u0627\u0633\u062a\u0645\u0627\u0631\u0629 \u0637\u0644\u0628 \u0641\u062a\u062d \u062d\u0633\u0627\u0628\u060c \u0648\u064a\u0645\u0643\u0646\u0643 \u0625\u064a\u062f\u0627\u0639 \u0623\u064a \u0645\u0628\u0644\u063a \u0646\u0642\u062f \u0645\u0646\u0627\u0633\u0628 \u0644\u0643. \r\n- \u062b\u0645 \u0642\u0645 \u0628\u062a\u0646\u0632\u064a\u0644 \u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0645\u0646 \u0645\u062a\u062c\u0631 \u062c\u0648\u062c\u0644 \u0628\u0644\u0627\u064a \u0627\u0648 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0647\u0646\u0627 \" https:\/\/play.google.com\/store\/apps\/details?id=wallet.mfloos.com.mflooswallet.customer&hl=ar \". \r\n- \u0633\u062a\u0635\u0644\u0643 \u0631\u0633\u0627\u0644\u0629 \u0646\u0635\u064a\u0629 \u0627\u0644\u0649 \u062c\u0648\u0627\u0644\u0643 \u0641\u064a\u0647\u0627 \u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0645\u0624\u0642\u062a\u0647 \u0627\u0644\u062a\u064a \u064a\u062a\u0648\u062c\u0628 \u0639\u0644\u064a\u0643 \u062a\u063a\u064a\u0631\u0647\u0627. \r\n- \u0627\u0628\u062f\u0623 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0645\u0646 \u0645\u0643\u0627\u0646\u0643 \u0628\u0643\u0644 \u0623\u0645\u0627\u0646 \u0648\u0633\u0647\u0648\u0644\u0629 \u0648\u0633\u0631\u0639\u0629.\r\n\r\n\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 ^_^"},{"id":40,"question":"\u0645\u0627\u0647\u0648 \u062d\u0633\u0627\u0628 \u0627\u0645 \u0641\u0644\u0633\u061f","answer":"\u0646\u0633\u0647\u0644 \u0639\u0644\u064a\u0643 \u0625\u062f\u0627\u0631\u0629 \u062a\u062d\u0648\u064a\u0644\u0627\u062a\u0643 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0639\u0628\u0631 \u0645\u0646\u062d\u0643 \u062d\u0633\u0627\u0628 (\u0627\u0645 \u0641\u0644\u0633) \u064a\u0641\u062a\u062d \u0644\u0643 \u0628\u0634\u0643\u0644 \u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0644\u0643 \u0639\u0628\u0631 \u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0648\u0627\u0644\u0630\u064a \u064a\u0644\u0628\u064a \u0627\u062d\u062a\u064a\u0627\u062c\u0643 \u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0627\u0644\u0645\u062d\u0648\u0644\u0629 \u0623\u0648 \u062a\u0646\u0641\u064a\u0630 \u0639\u0645\u0644\u064a\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644\u0647 \u0643\u0633\u062f\u0627\u062f \u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0623\u0648 \u062f\u0641\u0639 \u0642\u064a\u0645\u0629 \u0645\u0634\u062a\u0631\u064a\u0627\u062a\u0643 \u0628\u0637\u0631\u064a\u0642\u0629 \u0628\u0633\u064a\u0637\u0629 \u0648\u0622\u0645\u0646\u0629.\r\n\r\n\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 ^_^"},{"id":41,"question":"\u0644\u062f\u064a \u062d\u0633\u0627\u0628 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0648\u0623\u0631\u064a\u062f \u0623\u0646 \u0623\u0639\u0631\u0641 \u0645\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062e\u062f\u0645\u0629\u061f","answer":"\u0627\u0645 \u0641\u0644\u0648\u0633 \u0647\u064a \u062e\u062f\u0645\u0629 \u0646\u0642\u0648\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u062a\u0633\u062a\u0637\u064a\u0639 \u0645\u0646 \u062e\u0644\u0627\u0644\u0647\u0627:\r\n- \u0627\u0644\u0633\u062d\u0628 \u0645\u0646 \u062d\u0633\u0627\u0628\u0643 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0639\u0628\u0631 12.000 \u0648\u0643\u064a\u0644 \u0645\u0646\u062a\u0634\u0631\u064a\u0646 \u0641\u064a \u0643\u0644 \u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u064a\u0645\u0646.\r\n- \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0645\u0646 \u062d\u0633\u0627\u0628\u0643 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0625\u0644\u0649 \u0623\u064a \u062d\u0633\u0627\u0628 \u0641\u064a \u0628\u0646\u0643 \u0627\u0644\u0643\u0631\u064a\u0645\u064a \u0644\u0644\u062a\u0645\u0648\u064a\u0644 \u0627\u0644\u0623\u0635\u063a\u0631 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a.\r\n-  \u0633\u062f\u0627\u062f \u0641\u0648\u0627\u062a\u064a\u0631 \u0627\u0644\u062e\u062f\u0645\u0627\u062a (\u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u062b\u0627\u0628\u062a\u060c \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0646\u0642\u0627\u0644\u060c \u0627\u0644\u0627\u0646\u062a\u0631\u0646\u062a\u060c \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0621\u060c \u0627\u0644\u0645\u064a\u0627\u0647) \u0639\u0628\u0631 \u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633.\r\n-  \u0625\u0631\u0633\u0627\u0644 \u062d\u0648\u0627\u0644\u0629 \u0627\u0645 \u0641\u0644\u0633 \u0648\u0641\u062a\u062d \u062d\u0633\u0627\u0628 \u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0623\u064a \u0634\u062e\u0635 \u0648\u0633\u062d\u0628\u0647\u0627 \u0639\u0628\u0631 \u0623\u0643\u062b\u0631 \u0645\u0646 12.000 \u0648\u0643\u064a\u0644 \u0627\u0645 \u0641\u0644\u0648\u0633.\r\n-  \u0633\u062f\u0627\u062f \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0639\u0628\u0631 \u0623\u0643\u062b\u0631 \u0645\u0646 150.000 \u0646\u0642\u0637\u0629 \u062d\u0627\u0633\u0628 \u0645\u0646\u062a\u0634\u0631\u0629 \u0641\u064a \u062c\u0645\u064a\u0639 \u0623\u0646\u062d\u0627\u0621 \u0627\u0644\u062c\u0645\u0647\u0648\u0631\u064a\u0629.\r\n-  \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0643\u0627\u0641\u0629 \u0639\u0645\u0644\u064a\u0627\u062a\u0643 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u0646\u0641\u0630\u0629 \u0645\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0643\u0644 \u0633\u0647\u0648\u0644\u0629.\r\n-  \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0628\u062f\u0648\u0646 \u0627\u0646\u062a\u0631\u0646\u062a.\r\n\r\n\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 ^_^"},{"id":42,"question":"\u0645\u0646 \u0623\u064a\u0646 \u0627\u0633\u062a\u0637\u064a\u0639 \u062a\u062d\u0645\u064a\u0644 \u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633\u061f","answer":"\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u062a\u0637\u0628\u064a\u0642 \u0627\u0645 \u0641\u0644\u0648\u0633 \u0639\u0645\u0644\u0627\u0621 \u0645\u0646 \u0645\u062a\u062c\u0631 \u062c\u0648\u062c\u0644 \u0628\u0644\u0627\u064a \u0627\u0648 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u0627\u0644\u064a:  https:\/\/play.google.com\/store\/apps\/details?id=wallet.mfloos.com.mflooswallet.customer\r\n\r\n\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0631\u062c\u0649 \u0627\u0644\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 ^_^"},{"id":43,"question":"\u0623\u0646\u0627 \u0648\u0643\u064a\u0644 \u0627\u0645 \u0641\u0644\u0648\u0633\u060c \u0643\u064a\u0641 \u064a\u0645\u0643\u0646 \u0645\u0639\u0631\u0641\u0629 \u0639\u0645\u0648\u0644\u0627\u062a \u0625\u0631\u0633\u0627\u0644 \u062d\u0648\u0627\u0644\u0629 \u0627\u0645 \u0641\u0644\u0648\u0633\u061f","answer":"\u062a\u062e\u062a\u0644\u0641 \u0639\u0645\u0648\u0644\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0628\u0627\u062e\u062a\u0644\u0627\u0641 \u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u0645\u062d\u0648\u0644\u0629\u060c \u0648\u062a\u0633\u062a\u0637\u064a\u0639 \u0645\u0639\u0631\u0641\u0629 \u0639\u0645\u0648\u0644\u0629 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0639\u0646\u062f \u062a\u0623\u0643\u064a\u062f \u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0641\u0642\u0637."}],"success_stories":[],"type_of_application_form":null,"show_funding_calculator":0,"json_animation":"","service_bg":"","service_icon":"","service_logo":"","educational_material":[]},"other_services":[]}}