=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Worldpay-Ecomm-Payment-Gateway\" target=\"_parent\" data-lightning-target=\"_subtab\">Worldpay Ecomm<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Worldpay-Core-Payment-Gateway\" target=\"_parent\" data-lightning-target=\"_subtab\">Worldpay Core<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Zip\" target=\"_parent\" data-lightning-target=\"_subtab\">Zip<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><\/tbody><\/table>\n<div class=\"anchor-margin\" id=\"embedded-apps\"><\/div>\n<h4>APP PAYMENT PROCESSORS<\/h4>\n<p>In addition to the above payment gateway integrations, the following app payment processors are also <a href=\"http://bigcommerce.com/pricing/\" target=\"_blank\" rel=\"noopener noreferrer\">Embedded Payment Providers<\/a>:<\/p>\n<table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/acumatica-payments/\" target=\"_blank\" rel=\"noopener noreferrer\">Acumatica Payments<\/a><\/td><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/payfabric/\" target=\"_blank\" rel=\"noopener noreferrer\">Payfabric<\/a> (Global Payments)<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/bankful-payments/\" target=\"_blank\" rel=\"noopener noreferrer\">Bankful<\/a><\/td><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/sezzle/\" target=\"_blank\" rel=\"noopener noreferrer\">Sezzle<\/a><\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/fortis/\" target=\"_blank\" rel=\"noopener noreferrer\">Fortis<\/a><\/td><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/worldpay-wpg/\" target=\"_blank\" rel=\"noopener noreferrer\">Worldpay WPG<\/a><\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"https://www.bigcommerce.com/apps/klarna-checkout/\" target=\"_blank\" rel=\"noopener noreferrer\">Klarna Checkout<\/a><\/td><td colspan=\"1\" rowspan=\"1\"><\/td><\/tr><\/tbody><\/table>\n<\/div>\n<\/div>\n<div class=\"anchor-margin\" id=\"open-providers\"><\/div>\n<div class=\"section\" id=\"open-providers\"><a class=\"Permalink-link\" href=\"#open-providers\"> <\/a>\n<h3>Open Payment Providers<\/h3>\n<div class=\"section-content\">\n<p>Processing payments through methods outside of the <a href=\"#embedded-providers\">Embedded Payment Provider list<\/a> <strong>will incur<\/strong> <a href=\"/s/article/Pricing\" target=\"_parent\" data-lightning-target=\"_subtab\">Open Payment Provider fees<\/a> for stores on self-serve plans. Performance plan stores operating under contracted terms are not subject to this fee.<\/p>\n<p>See each gateway\u2019s documentation for details such as requirements, limitations, setup instructions, supported countries and currencies, and additional features.<\/p>\n<div class=\"panel panel-default\">\n<div class=\"panel-heading media\">\n<div class=\"media-left pull-left\"><span class=\"sl sl-lightbulb-2 alert-icon\"> <\/span><\/div>\n<div class=\"media-body\">\n<p class=\"lead\"><strong>Using a \u201cPowered By\u201d store?<\/strong> If you were onboarded to BigCommerce through a partner, you may not have access to all listed payment gateways.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<ul><li><strong>Manual Capture<\/strong> \u2014 Authorized payments can be <a href=\"/s/article/Manually-Capturing-Transactions-Authorize-Only\" target=\"_parent\" data-lightning-target=\"_subtab\">captured manually<\/a> at a later date.<\/li><li><strong>3D Secure<\/strong> \u2014 An <a href=\"/s/article/3D-Secure\" target=\"_parent\" data-lightning-target=\"_subtab\">additional security layer<\/a> that helps prevent unauthorized transactions.<\/li><li><strong>Multicurrency<\/strong> \u2014 Supports <a href=\"/s/article/Using-Multiple-Currencies\" target=\"_parent\" data-lightning-target=\"_subtab\">multiple transactional currencies<\/a>.<\/li><li><strong>Stored Payment Methods<\/strong> \u2014 Payment details <a href=\"/s/article/Enabling-Stored-Payment-Methods\" target=\"_parent\" data-lightning-target=\"_subtab\">can be stored<\/a> for future transactions.<\/li><li><strong>Recurring Payments<\/strong> \u2014 <a href=\"/s/article/Setting-up-Recurring-Billing\" target=\"_parent\" data-lightning-target=\"_subtab\">Recurring or subscription payments<\/a> are supported.<\/li><li><strong>MSF Payments<\/strong> \u2014 Supports <a href=\"/s/article/Multi-Storefront-Payment-Methods\" target=\"_parent\" data-lightning-target=\"_subtab\">multiple payment configurations<\/a>.<\/li><\/ul>\n<table><tbody><tr><td colspan=\"1\" rowspan=\"1\"><strong>Payment Gateway<\/strong><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><strong>Manual Capture<\/strong><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><strong>3D Secure<\/strong><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><strong>Multicurrency<\/strong><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><strong>Stored Payment Methods<\/strong><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><strong>Recurring Payments<\/strong><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><strong>MSF Payments<\/strong><\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Authorize-net\" target=\"_parent\" data-lightning-target=\"_subtab\">Authorize.net<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Barclaycard-Smartpay-Advance\" target=\"_parent\" data-lightning-target=\"_subtab\">Barclaycard Smartpay Advance<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-BitPay\" target=\"_parent\" data-lightning-target=\"_subtab\">BitPay<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Chase-Merchant-Services\" target=\"_parent\" data-lightning-target=\"_subtab\">Chase Merchant Services<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Clover-Payments\" target=\"_parent\" data-lightning-target=\"_subtab\">Clover Payments<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Commonwealth-Bank\" target=\"_parent\" data-lightning-target=\"_subtab\">Commonwealth Bank<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Cybersource\" target=\"_parent\" data-lightning-target=\"_subtab\">Cybersource<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Electronic-Payment-Exchange\" target=\"_parent\" data-lightning-target=\"_subtab\">Electronic Payment Exchange (EPX)<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/eWAY-Rapid-Payment-Gateway\" target=\"_parent\" data-lightning-target=\"_subtab\">Eway Rapid<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Mercado-Pago\" target=\"_parent\" data-lightning-target=\"_subtab\">Mercado Pago<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Moneris\" target=\"_parent\" data-lightning-target=\"_subtab\">Moneris<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-MyVirtualMerchant\" target=\"_parent\" data-lightning-target=\"_subtab\">MyVirtualMerchant<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Nexi-XPay\" target=\"_parent\" data-lightning-target=\"_subtab\">Nexi XPay<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-NMI\" target=\"_parent\" data-lightning-target=\"_subtab\">NMI<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Opayo-by-Elavon\" target=\"_parent\" data-lightning-target=\"_subtab\">Opayo by Elavon<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Optty\" target=\"_parent\" data-lightning-target=\"_subtab\">Optty<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-Quickbooks-Payments\" target=\"_parent\" data-lightning-target=\"_subtab\">QuickBooks Payments<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Serve-First\" target=\"_parent\" data-lightning-target=\"_subtab\">Serve First<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-Square-Payments-V2\" target=\"_parent\" data-lightning-target=\"_subtab\">Square<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Tilopay\" target=\"_parent\" data-lightning-target=\"_subtab\">Tilopay<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-USAePay\" target=\"_parent\" data-lightning-target=\"_subtab\">USAePay<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\"><a href=\"/s/article/Connecting-with-Windcave\" target=\"_parent\" data-lightning-target=\"_subtab\">Windcave<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔*<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"> <\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✔<\/td><\/tr><\/tbody><\/table>\n<p>*See article for details.<\/p>\n<div class=\"anchor-margin\" id=\"open-offline\"><\/div>\n<h4>OFFLINE PAYMENT METHODS<\/h4>\n<p>In addition to the above payment gateway integrations, orders processed using <a href=\"/s/article/Offline-Payment-Methods\" target=\"_parent\" data-lightning-target=\"_subtab\">offline payment methods<\/a> are also subject to the Open Payment Provider fee.<\/p>\n<table><tbody><tr><td colspan=\"1\" rowspan=\"1\">Bank deposit<\/td><td colspan=\"1\" rowspan=\"1\">Money order<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\">Cash on delivery<\/td><td colspan=\"1\" rowspan=\"1\">Pay in-store<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\">Check*<\/td><td colspan=\"1\" rowspan=\"1\"><\/td><\/tr><\/tbody><\/table>\n<p>*<a href=\"/s/article/B2B-Edition\" target=\"_parent\" data-lightning-target=\"_subtab\">B2B Edition<\/a> adopts the Check offline payment method to enable the Purchase Order (PO) payment method. Note that Performance plan stores operating under contracted terms are not subject to the Open Payment Provider fee.<\/p>\n<\/div>\n<\/div>\n<div class=\"anchor-margin\" id=\"apm\"><\/div>\n<div class=\"section\" id=\"apm\"><a class=\"Permalink-link\" href=\"#apm\"> <\/a>\n<h3>Alternative Payment Methods and Digital Wallets<\/h3>\n<div class=\"section-content\">\n<p>Alternative Payment Methods (APMs) are payment options that often do not require a major credit card scheme such as Visa or Mastercard. Shoppers in many regions prefer local APMs at checkout, making them a valuable tool for international selling.<\/p>\n<p>Offered through a supporting payment gateway, APMs can include payment types such as:<\/p>\n<ul><li>bank transfers<\/li><li>\u201cbuy now, pay later\u201d (BNPL)<\/li><li>cash payments<\/li><li>digital wallets<\/li><li>direct debit<\/li><li>mobile payments<\/li><\/ul>\n<p>Digital wallet APMs allow shoppers to complete purchases by signing into a third-party account, bypassing the need to create a separate account or re-enter payment information. This streamlines the checkout experience, boosts conversion rates, and provides a better mobile shopping experience.<\/p>\n<p>Note that the Amazon Pay, Apple Pay, and Google Pay digital wallets have a unique setup experience and are found under the <strong>Digital Wallets<\/strong> section of <strong>Settings \u203a Payments<\/strong>.<\/p>\n<p>For a full list of available APMs, digital wallets, and their supported gateways, see <a href=\"/s/article/Intro-to-APMs\" target=\"_parent\" data-lightning-target=\"_subtab\">Introduction to Alternative Payment Methods<\/a>.<\/p>\n<\/div>\n<\/div>\n<div class=\"anchor-margin\" id=\"accelerated-checkout\"><\/div>\n<div class=\"section\" id=\"accelerated-checkout\"><a class=\"Permalink-link\" href=\"#accelerated-checkout\"> <\/a>\n<h3>Accelerated Checkout Solutions<\/h3>\n<div class=\"section-content\">\n<p>Accelerated Checkout solutions remove friction from checkout by offering a passwordless checkout experience. When using an Accelerated Checkout, shoppers are prompted to securely save their information with the provider.<\/p>\n<p>Once they have an account, shoppers receive a one-time passcode to their mobile device whenever they enter their email address at checkout, and the Accelerated Checkout solution automatically fills in their address and payment information for a single-click checkout.<\/p>\n<p>Since Accelerated Checkout profiles are supported on any online store using the solution, offering this payment option can assure shoppers that their payments will be speedy and secure. This can encourage repeat purchases and increase your conversion rate.<\/p>\n<p>The following Accelerated Checkout solutions are available in BigCommerce:<\/p>\n<ul><li><strong>Stripe Link<\/strong> \u2014 Supported by the Stripe payment gateways; offer a streamlined checkout experience for any shopper with a Link profile.<\/li><li><strong>Fastlane by PayPal<\/strong> \u2014 <a href=\"/s/article/Fastlane-by-PayPal\" target=\"_parent\" data-lightning-target=\"_subtab\">Fastlane by PayPal<\/a> provides merchants with a fast, passwordless checkout solution for guest shoppers.<\/li><\/ul>\n<\/div>\n<\/div>\n<div class=\"anchor-margin\" id=\"faq\"><\/div>\n<div class=\"section\" id=\"faq\"><a class=\"Permalink-link\" href=\"#faq\"> <\/a>\n<h3>FAQ<\/h3>\n<div class=\"section-content\">\n<p><strong>Where do I manage my funds?<\/strong><\/p>\n<p>You will control and direct funds in your merchant account with your merchant service provider. Usually, this is where you will connect to your bank account or <a href=\"/s/article/Processing-Refunds\" target=\"_parent\" data-lightning-target=\"_subtab\">perform refunds<\/a> external to BigCommerce.<\/p>\n<p><strong>What is a hosted payment gateway?<\/strong><\/p>\n<p>Hosted payment gateways navigate shoppers away from your checkout to the payment service provider\u2019s page. After entering their payment details and completing the transaction, they are redirected back to your storefront.<\/p>\n<p>Hosted payment gateways:<\/p>\n<ul><li>Afterpay<\/li><li>Amazon Pay<\/li><li>BitPay<\/li><li>Klarna<\/li><li>Mercado Pago<\/li><li>Opayo<\/li><li>Optty<\/li><li>Serve First<\/li><li>Sezzle<\/li><\/ul>\n<p>Note that hosted gateways are not compatible with <a href=\"https://docs.bigcommerce.com/developer/docs/admin/checkout-and-cart/embedded-checkout/overview\" target=\"_blank\" rel=\"noopener noreferrer\">Embedded Checkout<\/a> on headless storefronts. In addition, most APMs and digital wallets do not support Embedded Checkout as they redirect shoppers to a hosted payment page.<\/p>\n<p>APMs and digital wallets that support Embedded Checkout:<\/p>\n<ul><li>Google Pay<\/li><li>PayPal Pay Later<\/li><\/ul>\n<p><strong>Do any payment gateways support Level 2 and Level 3 data?<\/strong><\/p>\n<p>Yes, several gateways support the use of Level 2 and Level 3 data. For more information, see <a href=\"/s/article/Using-Level-2-and-Level-3-Data-in-BigCommerce\" target=\"_parent\" data-lightning-target=\"_subtab\">Using Level 2 and Level 3 Data in BigCommerce<\/a>.<\/p>\n<p><strong>Do any payment gateways support the selling of regulated products, such as firearms, e-cigs, or CBD?<\/strong><\/p>\n<p>The following gateways <strong>may<\/strong> allow the sale of regulated items. Before selling any items, check with your payment gateway to make sure your products are permitted in their terms of service.<\/p>\n<ul><li><a href=\"https://bankful.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Bankful<\/a><\/li><li><a href=\"https://www.nmi.com/\" target=\"_blank\" rel=\"noopener noreferrer\">NMI<\/a><\/li><li><a href=\"https://sezzle.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Sezzle<\/a><\/li><li><a href=\"https://help.usaepay.info/\" target=\"_blank\" rel=\"noopener noreferrer\">USA ePay<\/a>*<\/li><li><a href=\"https://worldpay.payment-processors.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Worldpay<\/a><\/li><\/ul>\n<p>*You must use <a href=\"https://www.paysafe.com/us-en/\" target=\"_blank\" rel=\"noopener noreferrer\">Paysafe<\/a> as your Merchant Services Provider (MSP).<\/p>\n<p><strong>Are there other payment processors outside of payment gateways?<\/strong><\/p>\n<p>Yes, you can find additional payment processors on our <a href=\"https://www.bigcommerce.com/apps/categories/payments-security/payment-processors-gateways/\" target=\"_blank\" rel=\"noopener noreferrer\">App Marketplace<\/a>. Note that Open Payment Provider fees may apply. For more details, see <a href=\"/s/article/Pricing\" target=\"_parent\" data-lightning-target=\"_subtab\">About BigCommerce Pricing<\/a>.<\/p>\n<p><strong>How will I know if changes are made to my payment methods in the control panel?<\/strong><\/p>\n<p>When a payment method is enabled, disabled, or has settings updated, a notification will appear in the <a href=\"/s/article/Getting-Started-with-the-New-Control-Panel\" target=\"_parent\" data-lightning-target=\"_subtab\">control panel dashboard<\/a>.<\/p>\n<p><img src=\"https://storage.googleapis.com/bigcommerce-production-dev-center/Knowledge%20Base/Getting%20Started/Modern%20Control%20Panel%20Navigation/notifications-expanded-highlight.png\" alt=\"Notifications in the control panel dashboard\"><\/img><\/p>\n<p>You can also see records of changes to your payment methods in the <a href=\"/s/article/Using-Store-Logs\" target=\"_parent\" data-lightning-target=\"_subtab\">Staff Action Logs<\/a>.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<div class=\"article-footer\">\n<div class=\"section\">\n<h3 id=\"related\">Additional Resources<\/h3>\n<ul><li><a href=\"/s/article/3D-Secure\" target=\"_parent\" data-lightning-target=\"_subtab\">3D Secure<\/a><\/li><li><a href=\"/s/article/Enabling-Stored-Payment-Methods\" target=\"_parent\" data-lightning-target=\"_subtab\">Enabling Stored Payment Methods<\/a><\/li><li><a href=\"/s/article/Intro-to-APMs\" target=\"_parent\" data-lightning-target=\"_subtab\">Introduction to Alternative Payment Methods<\/a><\/li><li><a href=\"/s/article/Manually-Capturing-Transactions-Authorize-Only\" target=\"_parent\" data-lightning-target=\"_subtab\">Manually Capturing Transactions (Authorize Only)<\/a><\/li><li><a href=\"/s/article/Multi-Storefront-Payment-Methods\" target=\"_parent\" data-lightning-target=\"_subtab\">Multi-Storefront Payment Methods<\/a><\/li><li><a href=\"/s/article/Optimized-Single-Page-Checkout\" target=\"_parent\" data-lightning-target=\"_subtab\">Optimized One-Page Checkout<\/a><\/li><li><a href=\"/s/article/Setting-up-Recurring-Billing\" target=\"_parent\" data-lightning-target=\"_subtab\">Recurring Billing<\/a><\/li><li><a href=\"/s/article/Using-Multiple-Currencies\" target=\"_parent\" data-lightning-target=\"_subtab\">Using Multiple Currencies<\/a><\/li><li><a href=\"https://www.bigcommerce.com/payments/embedded-payment-providers/\" target=\"_blank\" rel=\"noopener noreferrer\">BigCommerce Embedded Payment Providers<\/a> (bigcommerce.com)<\/li><li><a href=\"https://www.bigcommerce.com/pricing/\" target=\"_blank\" rel=\"noopener noreferrer\">BigCommerce Pricing and Plan Information<\/a> (bigcommerce.com)<\/li><\/ul>\n<\/div>\n<\/div>\n<\/div>","KnowledgeArticleId":"kAATS0000000WG44AM","Title":"Available Payment Gateways","ArticleNumber":"000036070","ArticleCreatedById":"005a0000008U3n8AAC","LastPublishedDate":"2026-10-02T20:37:15.000Z","LastModifiedById":"0054O0000099pkoQAA","IsVisibleInApp":true,"IsVisibleInPkb":true,"ArticleCaseAttachCount":830,"Public_Author__c":"0051300000C7R7uAAF","Id":"kaAUG00000012uD2AQ"}},"error":[],"storable":true}],"context":{"mode":"PROD","app":"siteforce:communityApp","contextPath":"/s/sfsites","pathPrefix":"","fwuid":"ZVYtV2g3NHN0UGNVNzBMbldfZ0ZwZ2tVMjdnTGFERUU2S3FfSVdrcU92bkExNS4zLjE2MDEw","mlr":1,"uad":1,"coos":1,"loaded":{"APPLICATION@markup://siteforce:communityApp":"1897_Qx6CsUG7r803A_23Hon_1g"},"globalValueProviders":[{"type":"$Global","values":{"eswConfigDeveloperName":{"writable":true,"defaultValue":""},"isVoiceOver":{"writable":true,"defaultValue":false},"setupAppContextId":{"writable":true,"defaultValue":""},"density":{"writable":true,"defaultValue":""},"srcdoc":{"writable":false,"value":true},"appContextId":{"writable":true,"defaultValue":""},"dynamicTypeSize":{"writable":true,"defaultValue":""}}}],"enableAccessChecks":true,"apce":1,"dns":"c","ls":1,"lairn":[],"laerc":[],"lav":"68","lgef":["com.salesforce.locker.enableImmediateGlobalObjectPatching","com.salesforce.locker.enableTrustedTypesScript","com.salesforce.locker.walkRangeProtoChainForMethods","com.salesforce.locker.changesSince.258","com.salesforce.locker.changesSince.256","com.salesforce.locker.enabledChangesSince.256","com.salesforce.locker.temporaryGate","com.salesforce.locker.changesSince.262","com.salesforce.locker.enableSfdcLiveObject"],"cfcsd":"https://a.static.lightning.force.com/usa560.sfdc-lywfpd","mna":{"lightning":"interop"},"arse":1,"acaf":1,"icld":1,"ccv":"60569106","services":["markup://lightning:configProvider","markup://force:salesforceScopedModuleResolver","markup://force:ldsEngineCreator","markup://instrumentation:locatorSe