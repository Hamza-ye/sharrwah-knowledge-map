{"intent":"the account profile of the development store after the store country changed (the dashboard call)","do":"evaluate","js":"(async () => { const h = {\"accept\": \"application/json\", \"content-type\": \"application/json\", \"accept-language\": \"en\", \"role\": localStorage.getItem(\"role\"), \"store-id\": localStorage.getItem(\"storeId\"), \"x-manager-token\": localStorage.getItem(\"_t\")}; const r = await fetch(\"https://hermod.zid.sa/v1/managers/account/profile\", {method: \"GET\", headers: h, credentials: \"include\"}); const j = await r.json(); const s = j.user.store; return {status: r.status, business_location: j.user.business_location && {country: j.user.business_location.country && j.user.business_location.country.code, city: j.user.business_location.city && j.user.business_location.city.en_name}, profile_country: j.user.user_profile_data && j.user.user_profile_data.country && j.user.user_profile_data.country.code, store_currency: s.currency && s.currency.code, store_currencies: (s.currencies || []).map(c => c.code), timezone: s.timezone, package: s.subscription && s.subscription.package_code, markets_policy: s.subscription && s.subscription.policies_v2 && s.subscription.policies_v2[\"markets_management.active_markets\"]}; })()","readyTimeout":2000,"settleMs":500}
