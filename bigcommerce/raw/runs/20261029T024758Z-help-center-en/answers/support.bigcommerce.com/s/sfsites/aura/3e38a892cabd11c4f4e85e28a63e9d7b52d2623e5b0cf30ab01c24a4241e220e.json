{"actions":[{"id":"196;a","state":"SUCCESS","returnValue":null,"error":[]}],"context":{"mode":"PROD","app":"siteforce:communityApp","contextPath":"/s/sfsites","pathPrefix":"","fwuid":"ZVYtV2g3NHN0UGNVNzBMbldfZ0ZwZ2tVMjdnTGFERUU2S3FfSVdrcU92bkExNS4zLjE2MDEw","mlr":1,"uad":1,"coos":1,"loaded":{"APPLICATION@markup://siteforce:communityApp":"1897_Qx6CsUG7r803A_23Hon_1g"},"globalValueProviders":[{"type":"$Global","values":{"eswConfigDeveloperName":{"writable":true,"defaultValue":""},"isVoiceOver":{"writable":true,"defaultValue":false},"setupAppContextId":{"writable":true,"defaultValue":""},"density":{"writable":true,"defaultValue":""},"srcdoc":{"writable":false,"value":true},"appContextId":{"writable":true,"defaultValue":""},"dynamicTypeSize":{"writable":true,"defaultValue":""}}},{"type":"$Record","values":{"objectMetadata":{"Knowledge__kav":{"_canUseLapi":"true","_nameField":"Title","_entityLabel":"Knowledge","_keyPrefix":"kaA"}},"quickActionRecordTemplates":{},"recordErrors":{},"records":{"kaAUG0000000V9N2AU":{"Knowledge__kav":{"isPrimary":true,"record":{"apiName":"Knowledge__kav","childRelationships":{},"eTag":"f91b69aa8c8b2ad3cfe7001def21e6f8","fields":{"CreatedDate":{"displayValue":"4/13/2026 3:21 PM","value":"2026-04-13T15:21:55.000Z"},"Data_Category__c":{"displayValue":"User Docs","value":"User Docs"},"External_Link__c":{"displayValue":null,"value":"https://support.bigcommerce.com/s/article/Storefront-Checkout-Configurations"},"Id":{"displayValue":null,"value":"kaAUG0000000V9N2AU"},"LastModifiedById":{"displayValue":null,"value":"0054O000008rqRaQAI"},"LastModifiedDate":{"displayValue":"4/13/2026 3:21 PM","value":"2026-04-13T15:21:56.000Z"},"Public_Article_Status__c":{"displayValue":null,"value":null},"Public_Article__c":{"displayValue":null,"value":"<div class=\"article\">\n<div class=\"article-head\">\n<div class=\"tip\">\n<h2>What We&#39;ll Cover<\/h2>\n<ul><li><a href=\"#comparison\" target=\"_parent\">Checkout comparison<\/a><\/li><li><a href=\"#faq\" target=\"_parent\">FAQ<\/a><\/li><\/ul>\n<\/div>\n<\/div>\n<div class=\"article-body\">\n<div class=\"section\" id=\"intro\">\n<div class=\"section-content\">\n<p>Choosing a checkout configuration that matches your business needs can help enhance the shopper experience and improve conversion rates. Depending on your storefront setup, there are several different checkout configurations options available to you.<\/p>\n<p><img alt=\"Chart showing checkout configurations for Stencil and headless storefronts.\" src=\"https://storage.googleapis.com/bigcommerce-production-dev-center/Knowledge%20Base/Checkout/Storefront%20Checkout%20Configurations/checkout_configuration_chart.png\"><\/img><\/p>\n<p>Use this article to guide you and your development team in selecting the best configuration for your store\u2019s checkout environment.<\/p>\n<\/div>\n<\/div>\n<div class=\"anchor-margin\" id=\"comparison\"><\/div>\n<div class=\"section\" id=\"comparison\"><a class=\"Permalink-link\" href=\"#comparison\"> <\/a>\n<h3>Checkout Comparison<\/h3>\n<div class=\"section-content\">\n<p>This section compares the various checkout configurations available for storefronts, and highlights the benefits and potential limits associated with each checkout option.<\/p>\n<p>We recommend determining which type of storefront you will be using (<a href=\"/articles/en_US/Knowledge/The-Stencil-Theme-Platform\" target=\"_parent\" data-lightning-target=\"_subtab\">Stencil<\/a> versus <a href=\"https://docs.bigcommerce.com/docs/storefront/headless\" target=\"_blank\">headless<\/a> or <a href=\"https://docs.bigcommerce.com/docs/storefront\" target=\"_blank\">composable<\/a>), before reviewing the available checkout configurations so you can select the one that best matches your store\u2019s technical requirements.<\/p>\n<table><thead><tr><th colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">Checkout Option<\/th><th colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">Stencil Storefront<\/th><th colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">Headless or Composable Storefront<\/th><th colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">Checkout URL: <span style=\"font-size: 12px;\">mystore.com/checkout<\/span><\/th><th colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">Checkout URL: <span style=\"font-size: 12px;\">checkout.mystore.com/checkout<\/span><\/th><th colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">Checkout URL: <span style=\"font-size: 12px;\">checkout.mystore.com<\/span><\/th><\/tr><\/thead><tbody><tr><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><a href=\"#oopc\" target=\"_parent\">Optimized One-Page Checkout<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><a href=\"#open-checkout\" target=\"_parent\">Open Checkout<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><a href=\"#redirected-checkout\" target=\"_parent\">Redirected Checkout<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><a href=\"#embedded-checkout\" target=\"_parent\">Embedded Checkout<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><\/tr><tr><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\"><a href=\"#custom-headless\" target=\"_parent\">Custom Headless Checkout<\/a><\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✓<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><td colspan=\"1\" rowspan=\"1\" style=\"text-align: center;\">✗<\/td><\/tr><\/tbody><\/table>\n<div class=\"anchor-margin\" id=\"oopc\"><\/div>\n<h4>Optimized One-Page Checkout (OOPC)<\/h4>\n<ul><li><a href=\"/articles/en_US/Knowledge/Optimized-Single-Page-Checkout\" target=\"_parent\" data-lightning-target=\"_subtab\">Out-of-the-box checkout<\/a> for native BigCommerce storefronts<\/li><li>Optimized to drive high conversion rates<\/li><li>Minor styling and display customizations<\/li><li>Checkout URL \u2014 mystore.com/<strong>checkout<\/strong>\n<ul><li>The checkout page is a URL path that comes after the storefront root domain<\/li><\/ul>\n<\/li><\/ul>\n<div class=\"anchor-margin\" id=\"open-checkout\"><\/div>\n<h4>Open Checkout<\/h4>\n<ul><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/open-checkouts/guide\" target=\"_blank\">Customize the native BigCommerce storefront checkout<\/a> for greater control over your checkout experience<\/li><li>Acts as a starter kit for a custom checkout, without the need to build a checkout from scratch<\/li><li>Built with React and compiles into a static JavaScript bundle<\/li><li>Checkout URL \u2014 mystore.com/<strong>checkout<\/strong>\n<ul><li>The checkout page is a URL path that comes after the storefront root domain<\/li><\/ul>\n<\/li><\/ul>\n<div class=\"anchor-margin\" id=\"redirected-checkout\"><\/div>\n<h4>Redirected Checkout<\/h4>\n<ul><li>Redirects shoppers from your <a href=\"https://docs.bigcommerce.com/docs/storefront/headless\" target=\"_blank\">Headless<\/a> or <a href=\"https://docs.bigcommerce.com/docs/storefront\" target=\"_blank\">Composable<\/a> storefront to your BigCommerce storefront checkout page<\/li><li>Unlocks the full BigCommerce checkout experience, including hosted wallets<\/li><li>Customize your checkout layout through Stencil framework or Checkout SDK<\/li><li>Checkout URL \u2014 <strong>checkout<\/strong>.mystore.com/<strong>checkout<\/strong><\/li><li>The BigCommerce storefront domain must be served from a subdomain of the root domain\n<ul><li>The checkout page is a URL path that comes after the storefront root domain<\/li><\/ul>\n<\/li><\/ul>\n<div class=\"anchor-margin\" id=\"embedded-checkout\"><\/div>\n<h4>Embedded Checkout<\/h4>\n<ul><li>The BigCommerce storefront checkout page is embedded via an iframe, keeping shoppers on your headless storefront<\/li><li>Recommended for simple headless setups, such as <a href=\"/articles/en_US/Knowledge/BigCommerce-for-WordPress\" target=\"_parent\" data-lightning-target=\"_subtab\">BigCommerce for Wordpress<\/a><\/li><li>Supported by many <a href=\"/articles/en_US/Knowledge/Available-Payment-Gateways\" target=\"_parent\" data-lightning-target=\"_subtab\">payment gateways<\/a>, but not compatible with all digital wallets<\/li><li>Minor <a href=\"/articles/en_US/Knowledge/Optimized-Single-Page-Checkout\" target=\"_parent\" data-lightning-target=\"_subtab\">styling and display customizations<\/a><\/li><li>Checkout URL \u2014 <strong>checkout<\/strong>.mystore.com\n<ul><li>The BigCommerce storefront domain must be served from a subdomain of the root domain<\/li><li>The embedded checkout page\u2019s URL is not visible to shoppers<\/li><\/ul>\n<\/li><\/ul>\n<div class=\"anchor-margin\" id=\"custom-headless\"><\/div>\n<h4>Custom Headless Checkout<\/h4>\n<ul><li>Full control over your headless storefront checkout using <a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/guide/graphql-storefront\" target=\"_blank\">BigCommerce Cart and Checkout APIs<\/a><\/li><li>Keeps shoppers on your headless storefront without the need for a redirect<\/li><li>Processes payments using the <a href=\"https://docs.bigcommerce.com/docs/store-operations/payments\" target=\"_blank\">Payments API<\/a><\/li><li>Checkout URL \u2014 mystore.com/<strong>checkout<\/strong>\n<ul><li>The checkout page is a URL path that comes after the storefront root domain<\/li><\/ul>\n<\/li><\/ul>\n<\/div>\n<\/div>\n<div class=\"anchor-margin\" id=\"faq\"><\/div>\n<div class=\"section\" id=\"faq\"><a class=\"Permalink-link\" href=\"#faq\"> <\/a>\n<h3>FAQ<\/h3>\n<div class=\"section-content\">\n<p><strong>Do I need a developer?<\/strong><\/p>\n<p>A developer is <strong>highly recommended<\/strong> if you want to explore custom checkouts or headless storefronts. You can find a list of BigCommerce certified developers in our <a href=\"https://partners.bigcommerce.com/directory/\" target=\"_blank\">Partner Directory<\/a>.<\/p>\n<p><strong>Are the different checkout configurations limited to certain plans?<\/strong><\/p>\n<p>No, the checkout configurations listed above are available to all store plans.<\/p>\n<p><strong>Why does the Redirected and Embedded checkout URL need to be a subdomain of the storefront root domain?<\/strong><\/p>\n<p>Shoppers will encounter security errors and the checkout page will not load properly if the headless storefront domain doesn\u2019t match the BigCommerce storefront domain.<\/p>\n<p>You can configure your store\u2019s <a href=\"/articles/en_US/Knowledge/Domain-Settings-for-Headless-Storefronts\" target=\"_parent\" data-lightning-target=\"_subtab\">checkout domain<\/a> in Channel Manager or by upserting the URL <a href=\"https://docs.bigcommerce.com/docs/rest-management/channels/site-checkout-url#upsert-a-site%CA%BCs-checkout-url\" target=\"_blank\">via API<\/a>.<\/p>\n<p><strong>What checkout configurations are available for stores using Multi-Storefront?<\/strong><\/p>\n<p>Stores with <a href=\"/articles/en_US/Knowledge/Single-Storefront-vs-Multi-Storefront\" target=\"_parent\" data-lightning-target=\"_subtab\">more than one storefront<\/a> can use any of the checkout configurations listed above. In addition, several checkout settings can be configured <a href=\"/articles/en_US/Knowledge/Multi-Storefront\" target=\"_parent\" data-lightning-target=\"_subtab\">uniquely per storefront<\/a>.<\/p>\n<p><strong>Can I control the www redirect for my headless channel&#39;s unique checkout URL?<\/strong><\/p>\n<p>Yes, you can manage the setting via the <strong>Storefront SEO<\/strong> <a href=\"https://docs.bigcommerce.com/docs/rest-management/settings/storefront-seo#update-storefront-seo-settings\" target=\"_blank\">API endpoint<\/a>.<\/p>\n<\/div>\n<\/div>\n<\/div>\n<div class=\"article-footer\">\n<div class=\"section\">\n<h3 id=\"related\">Additional Resources<\/h3>\n<ul><li><a href=\"/articles/en_US/Knowledge/Optimized-Single-Page-Checkout\" target=\"_parent\" data-lightning-target=\"_subtab\">Optimized One-Page Checkout<\/a><\/li><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/optimized-one-page-checkout\" target=\"_blank\">Optimized One-Page Checkout<\/a> (Dev Center)<\/li><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout\" target=\"_blank\">Checkout Customizability<\/a> (Dev Center)<\/li><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/open-checkouts/guide\" target=\"_blank\">Installing an Open Source Checkout<\/a> (Dev Center)<\/li><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/checkout-sdk\" target=\"_blank\">Getting Started with Checkout SDK<\/a> (Dev Center)<\/li><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/embedded-checkout\" target=\"_blank\">Embedded Checkout Overview<\/a> (Dev Center)<\/li><li><a href=\"https://docs.bigcommerce.com/docs/storefront/cart-checkout/guide/graphql-storefront\" target=\"_blank\">GraphQL Storefront API: Carts and Checkout<\/a> (Dev Center)<\/li><\/ul>\n<\/div>\n<\/div>\n<\/div>"},"Public_Author__c":{"displayValue":null,"value":"0054O0000099pkoQAA"},"Public_Author__r":{"displayValue":"Nick Vineyard","value":{"apiName":"User","childRelationships":{},"eTag":"f041b14a055cb2c0a43dcc8393518de3","fields":{"Id":{"displayValue":null,"value":"0054O0000099pkoQAA"},"Name":{"displayValue":null,"value":"Nick Vineyard"}},"id":"0054O0000099pkoQAA","lastModifiedById":"0054O00000AZvtEQAT","lastModifiedDate":"2026-06-27T14:00:00.000Z","recordTypeId":null,"recordTypeInfo":null,"systemModstamp":"2026-08-28T15:04:23.000Z","weakEtag":1787929463000}},"Public_Exclude_from_Search_Index__c":{"displayValue":null,"value":false},"Public_Last_Maintenance_Review_Date__c":{"displayValue":"9/25/2024","value":"2024-09-25"},"Public_Last_Review_Date__c":{"displayValue":"11/18/2024","value":"2024-11-18"},"Public_Nav_Title__c":{"displayValue":null,"value":"Storefront Checkout Configurations"},"Public_Search_Terms__c":{"displayValue":null,"value":null},"Public_Section_Anchors__c":{"displayValue":null,"value":"Checkout Comparison:comparison;FAQ:faq;"},"Public_Sort_Oder_in_Category__c":{"displayValue":null,"value":null},"RecordTypeId":{"displayValue":null,"value":"012TS000002jSbnYAE"},"Record_Locked__c":{"displayValue":null,"value":false},"Sub_Data_Category__c":{"displayValue":"Checkout","value":"Checkout"},"Summary":{"displayValue":null,"value":"List of available checkout configurations for Stencil and headless storefronts."},"Syst