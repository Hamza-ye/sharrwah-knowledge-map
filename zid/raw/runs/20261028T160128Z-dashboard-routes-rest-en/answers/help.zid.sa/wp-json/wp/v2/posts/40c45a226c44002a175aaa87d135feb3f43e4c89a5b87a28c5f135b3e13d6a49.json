[{"id":7184,"date":"2025-09-25T14:11:03","date_gmt":"2025-09-25T11:11:03","guid":{"rendered":"https:\/\/help.zid.sa\/?p=7184"},"modified":"2026-10-22T00:59:05","modified_gmt":"2026-10-21T21:59:05","slug":"create-new-affiliate","status":"publish","type":"post","link":"https:\/\/help.zid.sa\/create-new-affiliate\/","title":{"rendered":"\u0625\u0646\u0634\u0627\u0621 \u0645\u0633\u0648\u0651\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629"},"content":{"rendered":"<p><strong>\u0627\u0644\u0645\u0633\u0648\u0651\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629<\/strong> \u0647\u0648 \u0645\u0633\u0648\u0642 \u064a\u0633\u0627\u0639\u062f\u0643 \u0641\u064a \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0648\u0627\u0644\u062a\u0631\u0648\u064a\u062c \u0644\u0645\u0646\u062a\u062c\u0627\u062a\u0643\u060c \u0645\u0642\u0627\u0628\u0644 \u062d\u0635\u0648\u0644\u0647 \u0639\u0644\u0649 \u0639\u0645\u0648\u0644\u0629 \u0627\u0646\u062a \u062a\u062d\u062f\u062f\u0647\u0627 \u0644\u0647 \u0633\u0648\u0627\u0621\u064b \u0645\u0628\u0644\u063a \u0645\u0646 \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0623\u0648 \u0646\u0633\u0628\u0629 \u0645\u0646 \u0627\u0644\u0645\u062c\u0645\u0648\u0639 (\u062d\u0633\u0628 \u0627\u062a\u0641\u0627\u0642\u0643 \u0645\u0639 \u0627\u0644\u0645\u0633\u0648\u0642).<\/p>\n<h6>\u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 &gt; \u0627\u0644\u062a\u0633\u0648\u064a\u0642&gt; \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629<\/h6>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-7185\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629.png\" alt=\"\" width=\"1882\" height=\"475\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629.png 1882w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629-300x76.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629-1024x258.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629-768x194.png 768w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629-1536x388.png 1536w\" sizes=\"auto, (max-width: 1882px) 100vw, 1882px\" \/><\/p>\n<hr \/>\n<h5>\u0625\u0646\u0634\u0627\u0621 \u0645\u0633\u0648\u0642 \u062c\u062f\u064a\u062f :<\/h5>\n<p>\u0644\u0625\u0646\u0634\u0627\u0621 \u0645\u0633\u0648\u0642 \u062c\u062f\u064a\u062f \u0642\u0645 \u0628\u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u064a\u0642\u0648\u0646\u0629 \u0625\u0646\u0634\u0627\u0621<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-9897\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0647-\u0627\u0646\u0634\u0627\u0621-.png\" alt=\"\" width=\"1509\" height=\"277\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0647-\u0627\u0646\u0634\u0627\u0621-.png 1509w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0647-\u0627\u0646\u0634\u0627\u0621--300x55.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0647-\u0627\u0646\u0634\u0627\u0621--1024x188.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u062a\u0633\u0648\u064a\u0642-\u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0647-\u0627\u0646\u0634\u0627\u0621--768x141.png 768w\" sizes=\"auto, (max-width: 1509px) 100vw, 1509px\" \/><\/p>\n<h6>\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0633\u0648\u0642 :<\/h6>\n<p>\u0627\u0636\u0641 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u0648\u0642 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647 \u0645\u062b\u0644: \u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u0648\u0642\u060c \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0627\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u060c \u062f\u0648\u0644\u0629 \u0627\u0644\u0645\u0633\u0648\u0642 \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0628\u0646\u0643\u064a.<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-7186\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0628\u064a\u0627\u0646\u0627\u062a-\u0627\u0644\u0645\u0633\u0648\u0642.png\" alt=\"\" width=\"1548\" height=\"753\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0628\u064a\u0627\u0646\u0627\u062a-\u0627\u0644\u0645\u0633\u0648\u0642.png 1548w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0628\u064a\u0627\u0646\u0627\u062a-\u0627\u0644\u0645\u0633\u0648\u0642-300x146.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0628\u064a\u0627\u0646\u0627\u062a-\u0627\u0644\u0645\u0633\u0648\u0642-1024x498.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0628\u064a\u0627\u0646\u0627\u062a-\u0627\u0644\u0645\u0633\u0648\u0642-768x374.png 768w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0628\u064a\u0627\u0646\u0627\u062a-\u0627\u0644\u0645\u0633\u0648\u0642-1536x747.png 1536w\" sizes=\"auto, (max-width: 1548px) 100vw, 1548px\" \/><\/p>\n<hr \/>\n<h5>\u0627\u0644\u0639\u0645\u0648\u0644\u0629 :<\/h5>\n<h6>\u0627\u0636\u0641 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u062d\u062a\u0633\u0627\u0628\u0647\u0627 \u0645\u062b\u0644:<\/h6>\n<div class=\"callout4\">\n<h5>\u0645\u0644\u0627\u062d\u0638\u0629\ud83d\udca1:<\/h5>\n<p>\u064a\u062a\u0645 \u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0639\u0645\u0644\u0629 \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0644\u0644\u0645\u062a\u062c\u0631 .<\/p>\n<\/div>\n<p>&nbsp;<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-9898\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u0639\u0645\u0648\u0644\u0629-.png\" alt=\"\" width=\"1186\" height=\"421\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u0639\u0645\u0648\u0644\u0629-.png 1186w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u0639\u0645\u0648\u0644\u0629--300x106.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u0639\u0645\u0648\u0644\u0629--1024x363.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/09\/\u0627\u0644\u0639\u0645\u0648\u0644\u0629--768x273.png 768w\" sizes=\"auto, (max-width: 1186px) 100vw, 1186px\" \/><\/p>\n<div id=\"index3\">\n<ul>\n<li>\n<h6>\u062d\u062f\u062f \u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0641\u064a \u062d\u0627\u0644 \u0643\u0627\u0646\u062a \u0646\u0633\u0628\u0629 \u0645\u0646 \u0627\u0644\u0645\u062c\u0645\u0648\u0639 \u0623\u0648 \u0645\u0628\u0644\u063a \u0645\u0646 \u0627\u0644\u0645\u062c\u0645\u0648\u0639.<\/h6>\n<\/li>\n<li>\n<h6>\u062d\u062f\u062f \u0637\u0631\u064a\u0642\u0629 \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0644\u0644\u0645\u0633\u0648\u0642 \u0641\u064a \u062d\u0627\u0644 \u0643\u0627\u0646:<\/h6>\n<\/li>\n<\/ul>\n<ol>\n<li>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0637\u0644\u0628 \u0628\u062f\u0648\u0646 \u0627\u0644\u0636\u0631\u064a\u0628\u0629 \u0648 \u0627\u0644\u0634\u062d\u0646: \u0647\u0646\u0627 \u064a\u062a\u0645 \u0627\u062d\u062a\u0633\u0627\u0628 \u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0641\u0642\u0637.<\/li>\n<li>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0637\u0644\u0628 \u0645\u0639 \u0627\u0644\u0636\u0631\u064a\u0628\u0629 \u0648\u0627\u0644\u0634\u062d\u0646: \u0647\u0646\u0627 \u064a\u062a\u0645 \u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0646\u0647\u0627\u0626\u064a \u0644\u0641\u0627\u062a\u0648\u0631\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a.<\/li>\n<\/ol>\n<p>&nbsp;<\/p>\n<ul>\n<li>\n<h6>\u062d\u062f\u062f \u0637\u0631\u064a\u0642\u0629 \u062a\u0637\u0628\u064a\u0642 \u0648\u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0644\u0629 \u0641\u064a \u062d\u0627\u0644 \u0643\u0627\u0646 \u0627\u0644\u0637\u0644\u0628 \u062c\u062f\u064a\u062f \u0623\u0648 \u0628\u0639\u062f \u0627\u0643\u062a\u0645\u0627\u0644\u0647 \u0648\u062a\u0648\u0635\u064a\u0644\u0647 \u0644\u0644\u0639\u0645\u064a\u0644 \u0627\u0644\u0646\u0647\u0627\u0626\u064a.<\/h6>\n<\/li>\n<li>\n<h6>\u0627\u062f\u062e\u0644 \u0642\u064a\u0645\u0629 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u062d\u0633\u0628 \u0627\u062e\u062a\u064a\u0627\u0631\u0643 \u0644\u0645\u0628\u0644\u063a \u062b\u0627\u0628\u062a \u0627\u0645 \u0646\u0633\u0628\u0629<\/h6>\n<\/li>\n<\/ul>\n<\/div>\n<hr \/>\n<h5>\u0627\u0644\u062e\u0635\u0645 :<\/h5>\n<p>\u0641\u064a \u062d\u0627\u0644 \u0625\u0636\u0627\u0641\u0629 \u0642\u0633\u064a\u0645\u0629 \u062a\u062e\u0641\u064a\u0636 \u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u0648\u0642 \u0642\u0645 \u0628\u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u062e\u0635\u0645 \u062b\u0645 \u0642\u0645 \u0628\u0625\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0642\u0633\u064a\u0645\u0629 \u0627\u0644\u0645\u0641\u0639\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u062a\u062c\u0631 \u0645\u0633\u0628\u0642\u0627 \u0641\u064a \u0642\u0633\u0627\u0626\u0645 \u0627\u0644\u062a\u0633\u0648\u064a\u0642<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-7188\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062e\u0635\u0645.png\" alt=\"\" width=\"1449\" height=\"406\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062e\u0635\u0645.png 1449w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062e\u0635\u0645-300x84.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062e\u0635\u0645-1024x287.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u062e\u0635\u0645-768x215.png 768w\" sizes=\"auto, (max-width: 1449px) 100vw, 1449px\" \/><\/p>\n<p>\u0642\u0645 \u0628\u062a\u0641\u0639\u064a\u0644 \u062e\u064a\u0627\u0631 \u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a \u0648\u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0644\u0644\u0645\u0633\u0648\u0642 \u0641\u064a \u062d\u0627\u0644 \u0631\u063a\u0628\u062a\u0643 \u0628\u0627\u062d\u062a\u0633\u0627\u0628 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0644\u0647 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0642\u0633\u064a\u0645\u0629 \u2705<\/p>\n<p>\u0625\u0630\u0627 \u0644\u0645 \u062a\u0643\u0646 \u0644\u062f\u064a\u0643 \u0642\u0633\u064a\u0645\u0629 \u0645\u0641\u0639\u0651\u0644\u0629\u060c \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 &#8220;\u0625\u0646\u0634\u0627\u0621 \u0643\u0648\u062f \u062e\u0635\u0645 \u062c\u062f\u064a\u062f &#8221; \u0644\u0644\u0627\u0646\u062a\u0642\u0627\u0644 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0642\u0633\u0627\u0626\u0645 \u0648\u0625\u0646\u0634\u0627\u0621 \u0642\u0633\u064a\u0645\u0629 \u062c\u062f\u064a\u062f\u0629 \u0627\u0648 \u0625\u0639\u0627\u062f\u0629 \u062a\u0641\u0639\u064a\u0644 \u0642\u0633\u064a\u0645\u0629 \u0633\u0627\u0628\u0642\u0629<\/p>\n<hr \/>\n<h5 id=\"index6\">\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a :<\/h5>\n<div>\u0628\u0625\u0645\u0643\u0627\u0646\u0643 \u062a\u062d\u062f\u064a\u062f \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0623\u0648 \u0645\u0646\u062a\u062c\u0627\u062a \u0645\u062d\u062f\u062f\u0629 \u0623\u0648 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062d\u062f\u062f\u0629 \u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0639\u0645\u0648\u0644\u0629 \u0648\u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u062e\u0635\u0635\u0629 \u0628\u0639\u062f \u0625\u0646\u0634\u0627\u0621 \u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629.<\/div>\n<div><\/div>\n<div><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-7189\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a.png\" alt=\"\" width=\"1327\" height=\"210\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a.png 1327w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a-300x47.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a-1024x162.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2025\/05\/\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a-768x122.png 768w\" sizes=\"auto, (