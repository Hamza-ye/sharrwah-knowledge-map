[{"id": 8942, "question": {"en": "\u0627\u0646\u062a\u0648 \u0645\u062a\u062c\u0631 \u0641\u0639\u0644\u064a \u061f", "ar": "\u0627\u0646\u062a\u0648 \u0645\u062a\u062c\u0631 \u0641\u0639\u0644\u064a \u061f"}, "answer": {"en": "<p><span style=\"caret-color: rgb(153, 153, 153); color: rgb(153, 153, 153); font-family: flat-jooza; font-size: 16px; font-weight: normal; text-size-adjust: auto;\">\u0644\u0627 \u0627\u062d\u0646\u0627 \u0645\u062a\u062c\u0631 \u0644\u0644\u0639\u0631\u0636 \u0641\u0642\u0637 \u0648\u0644\u064a\u0633 \u0644\u0644\u0628\u064a\u0639\u060c \u0645\u062a\u062c\u0631 \u062a\u062c\u0631\u064a\u0628\u064a.</span><br></p>", "ar": "<p><span style=\"caret-color: rgb(153, 153, 153); color: rgb(153, 153, 153); font-family: flat-jooza; font-size: 16px; font-weight: normal; text-size-adjust: auto;\">\u0644\u0627 \u0627\u062d\u0646\u0627 \u0645\u062a\u062c\u0631 \u0644\u0644\u0639\u0631\u0636 \u0641\u0642\u0637 \u0648\u0644\u064a\u0633 \u0644\u0644\u0628\u064a\u0639\u060c \u0645\u062a\u062c\u0631 \u062a\u062c\u0631\u064a\u0628\u064a.</span><br></p>"}, "priority": null, "is_published": true}, {"id": 8943, "question": {"en": "\u0623\u0639\u062c\u0628\u0646\u064a \u0645\u062a\u062c\u0631\u0643\u0645 \u060c \u0648\u0627\u0628\u063a\u0627 \u0645\u062a\u062c\u0631 \u064a\u0634\u0628\u0647\u0647 \u0644\u0647 \u061f", "ar": "\u0623\u0639\u062c\u0628\u0646\u064a \u0645\u062a\u062c\u0631\u0643\u0645 \u060c \u0648\u0627\u0628\u063a\u0627 \u0645\u062a\u062c\u0631 \u064a\u0634\u0628\u0647\u0647 \u0644\u0647 \u061f"}, "answer": {"en": "<p><span style=\"caret-color: rgb(153, 153, 153); color: rgb(153, 153, 153); font-family: flat-jooza; font-size: 16px; font-weight: normal; text-size-adjust: auto;\">\u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u062c\u0631 \u0645\u064f\u0628\u0631\u0645\u062c \u0628\u0648\u0627\u0633\u0637\u0629 \u0632\u0650\u062f \u0648\u0647\u0648 \u0645\u064f\u062a\u0627\u062d \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u062c\u0627\u0631. \u0627\u0634\u062a\u0631\u0643 \u0645\u0639\u0646\u0627 \u0648\u0623\u0628\u062f\u0623 \u0645\u062a\u062c\u0631\u0643 \u0627\u0644\u0645\u062a\u0643\u0627\u0645\u0644 \u0641\u064a \u062f\u0642\u0627\u0626\u0642!\u00a0</span><br></p>", "ar": "<p><span style=\"caret-color: rgb(153, 153, 153); color: rgb(153, 153, 153); font-family: flat-jooza; font-size: 16px; font-weight: normal; text-size-adjust: auto;\">\u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u062c\u0631 \u0645\u064f\u0628\u0631\u0645\u062c \u0628\u0648\u0627\u0633\u0637\u0629 \u0632\u0650\u062f \u0648\u0647\u0648 \u0645\u064f\u062a\u0627\u062d \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u062c\u0627\u0631. \u0627\u0634\u062a\u0631\u0643 \u0645\u0639\u0646\u0627 \u0648\u0623\u0628\u062f\u0623 \u0645\u062a\u062c\u0631\u0643 \u0627\u0644\u0645\u062a\u0643\u0627\u0645\u0644 \u0641\u064a \u062f\u0642\u0627\u0626\u0642!\u00a0</span><br></p>"}, "priority": null, "is_published": true}]