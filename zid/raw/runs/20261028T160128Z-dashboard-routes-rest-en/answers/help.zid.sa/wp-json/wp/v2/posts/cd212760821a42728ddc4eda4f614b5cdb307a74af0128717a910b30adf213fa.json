[{"id":12590,"date":"2026-05-17T14:10:11","date_gmt":"2026-05-17T11:10:11","guid":{"rendered":"https:\/\/help.zid.sa\/?p=12590"},"modified":"2026-10-22T01:04:03","modified_gmt":"2026-10-21T22:04:03","slug":"discount-management","status":"publish","type":"post","link":"https:\/\/help.zid.sa\/discount-management\/","title":{"rendered":"\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a"},"content":{"rendered":"<p><strong>\u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a<\/strong> \u0647\u064a \u0623\u062f\u0627\u062a\u0643 \u0627\u0644\u0623\u0642\u0648\u0649 \u0644\u0644\u062a\u0631\u0648\u064a\u062c: \u062a\u0631\u0641\u0639 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\u060c \u062a\u0634\u062c\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0627\u0621\u060c \u0648\u062a\u0632\u064a\u062f \u0645\u062a\u0648\u0633\u0637 \u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628. \u062a\u0648\u0641\u0631 \u0644\u0643 \u0632\u062f \u0646\u0638\u0627\u0645 \u0645\u0631\u0646 \u064a\u062f\u0639\u0645 \u0623\u0646\u0648\u0627\u0639 \u0645\u062a\u0639\u062f\u062f\u0629 \u0645\u0646 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a\u060c \u0645\u0646 \u0643\u0648\u0628\u0648\u0646 \u0628\u0633\u064a\u0637\u060c \u062e\u0635\u0645 \u064a\u0637\u0628\u0642 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627\u060c \u062e\u0635\u0648\u0645\u0627\u062a \u062a\u0635\u0627\u0639\u062f\u064a\u0629 \u0645\u0639\u0642\u062f\u0629\u060c \u0625\u0644\u0649 \u0623\u0643\u0648\u0627\u062f \u0645\u062a\u0639\u062f\u062f\u0629 \u0644\u0634\u0631\u0643\u0627\u0621 \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629.<\/p>\n<p><strong>\u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0648\u0635\u0648\u0644 \u0644\u0644\u062e\u0627\u0635\u064a\u0629 \u0645\u0646 \u062e\u0644\u0627\u0644 :<\/strong><\/p>\n<p>\u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645&gt;\u0627\u0644\u062a\u0633\u0648\u064a\u0642 &gt; <span style=\"color: #3366ff;\"><a style=\"color: #3366ff;\" href=\"https:\/\/dashboard.zid.sa\/ar-sa\/stores\/201043\/marketing\/discounts\" target=\"_blank\" rel=\"noopener\">\u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a<\/a><\/span><\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-12708\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-124118.png\" alt=\"\" width=\"1915\" height=\"756\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-124118.png 1915w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-124118-300x118.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-124118-1024x404.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-124118-768x303.png 768w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-124118-1536x606.png 1536w\" sizes=\"auto, (max-width: 1915px) 100vw, 1915px\" \/><\/p>\n<p><strong>\u0633\u062a\u0638\u0647\u0631 \u0644\u0643 \u0642\u0627\u0626\u0645\u0629 \u0628\u062c\u0645\u064a\u0639 \u062e\u0635\u0648\u0645\u0627\u062a \u0645\u062a\u062c\u0631\u0643 \u0645\u0639:<\/strong><\/p>\n<ul>\n<li>\u00a0\u0627\u0633\u0645 \u0627\u0644\u062e\u0635\u0645 \u0648\u0643\u0648\u062f\u0647 (\u0625\u0646 \u0648\u064f\u062c\u062f).<\/li>\n<li>\u0646\u0648\u0639 \u0627\u0644\u062e\u0635\u0645.<\/li>\n<li>\u062d\u0627\u0644\u062a\u0647 ( \u0645\u062c\u062f\u0648\u0644 \\ \u0645\u0641\u0639\u0651\u0644 \\ \u063a\u064a\u0631 \u0646\u0634\u0637 \\ \u0645\u0646\u062a\u0647\u064a ).<\/li>\n<li>\u0646\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0648\u0627\u0644\u0646\u0647\u0627\u064a\u0629.<\/li>\n<li>\u0642\u064a\u0645\u0629 \u0627\u0644\u062e\u0635\u0645.<\/li>\n<\/ul>\n<hr \/>\n<div id=\"index1\"><\/div>\n<h5>\u00a0\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a<\/h5>\n<p>\u0644\u0631\u0624\u064a\u0629 \u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0623\u062f\u0627\u0621 \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0633\u0647\u0645 \u0628\u062c\u0627\u0646\u0628 \u0623\u064a \u062e\u0635\u0645:<\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-12595\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x.png\" alt=\"\" width=\"2418\" height=\"528\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x.png 2418w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x-300x66.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x-1024x224.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x-768x168.png 768w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x-1536x335.png 1536w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/CleanShot-2026-05-17-at-00.44.45@2x-2048x447.png 2048w\" sizes=\"auto, (max-width: 2418px) 100vw, 2418px\" \/><\/p>\n<p><strong>\u0633\u062a\u0638\u0647\u0631 \u0644\u0643 :<\/strong><\/p>\n<ul>\n<li>\u0645\u062c\u0645\u0648\u0639 \u0645\u0631\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645: \u0643\u0645 \u0645\u0631\u0629 \u0637\u064f\u0628\u0650\u0651\u0642 \u0627\u0644\u062e\u0635\u0645<\/li>\n<li>\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621: \u0639\u062f\u062f \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0627\u0644\u0630\u064a\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0648\u0627<\/li>\n<li>\u0645\u062c\u0645\u0648\u0639 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a: \u0625\u062c\u0645\u0627\u0644\u064a \u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0644\u062e\u0635\u0645<\/li>\n<\/ul>\n<p><strong>\u0628\u0639\u062f \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u062b\u0644\u0627\u062b \u0646\u0642\u0627\u0637 (\u22ee) \u0628\u062c\u0627\u0646\u0628 \u0623\u064a \u062e\u0635\u0645 \u064a\u0645\u0643\u0646\u0643:<\/strong><\/p>\n<ul>\n<li>\u062a\u0639\u062f\u064a\u0644 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062e\u0635\u0645<\/li>\n<li>\u0639\u0631\u0636 \u0627\u0644\u0637\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u062e\u062f\u0645\u062a \u0647\u0630\u0627 \u0627\u0644\u062e\u0635\u0645.<\/li>\n<li>\u0646\u0633\u062e \u0631\u0627\u0628\u0637 \u0627\u0644\u0643\u0648\u062f: \u0631\u0627\u0628\u0637 \u0645\u0628\u0627\u0634\u0631 \u062a\u0634\u0627\u0631\u0643\u0647 \u0645\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 (\u064a\u064f\u0637\u0628\u0650\u0651\u0642 \u0627\u0644\u0643\u0648\u062f \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u0627\u0644\u0636\u063a\u0637).<\/li>\n<li>\u062a\u0643\u0631\u0627\u0631: \u0625\u0646\u0634\u0627\u0621 \u0646\u0633\u062e\u0629 \u0628\u0646\u0641\u0633 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a (\u0645\u0641\u064a\u062f \u0644\u0644\u062d\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0648\u0633\u0645\u064a\u0629 \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0629)<\/li>\n<li>\u062d\u0630\u0641: \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u062e\u0635\u0645 \u0646\u0647\u0627\u0626\u064a\u064b\u0627<\/li>\n<\/ul>\n<p><img loading=\"lazy\" decoding=\"async\" class=\" wp-image-12706 aligncenter\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123920.png\" alt=\"\" width=\"833\" height=\"202\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123920.png 1569w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123920-300x73.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123920-1024x248.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123920-768x186.png 768w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123920-1536x372.png 1536w\" sizes=\"auto, (max-width: 833px) 100vw, 833px\" \/><\/p>\n<ul>\n<li>\u064a\u0645\u0643\u0646\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u0641\u0644\u0627\u062a\u0631 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u062e\u0635\u0645 \u0645\u0639\u064a\u0646 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0643\u0648\u062f \u0623\u0648 \u0627\u0633\u0645 \u0627\u0644\u0639\u0631\u0636\u060c \u0623\u0648 \u0641\u0631\u0632 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u062d\u0633\u0628 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062e\u0635\u0645.<\/li>\n<li>\u0648\u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u062a\u0635\u0641\u064a\u0629 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0644\u0644\u0628\u062d\u062b \u0628\u0634\u0643\u0644 \u0623\u0633\u0631\u0639.<\/li>\n<\/ul>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-12705 aligncenter\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123501.png\" alt=\"\" width=\"715\" height=\"303\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123501.png 1560w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123501-300x127.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123501-1024x435.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123501-768x326.png 768w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-123501-1536x652.png 1536w\" sizes=\"auto, (max-width: 715px) 100vw, 715px\" \/><\/p>\n<p>&nbsp;<\/p>\n<hr \/>\n<div id=\"index2\"><\/div>\n<h5>\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u062d\u0629<\/h5>\n<p><strong>\u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u062e\u0635\u0645 \u0641\u064a \u0632\u062f\u060c \u062a\u062a\u062e\u0630 \u0642\u0631\u0627\u0631\u064e\u064a\u0646 \u0623\u0633\u0627\u0633\u064a\u064a\u0646:<\/strong><\/p>\n<ol>\n<li><strong>\u0646\u0648\u0639 \u0627\u0644\u062e\u0635\u0645: \u0645\u0627\u0630\u0627 \u062a\u0642\u062f\u0645\u061f<\/strong><\/li>\n<\/ol>\n<ul>\n<li>\u062e\u0635\u0645 \u0639\u0627\u062f\u064a<\/li>\n<li>\u062e\u0635\u0645 \u062a\u0635\u0627\u0639\u062f\u064a<\/li>\n<li>\u062e\u0635\u0645 \u0639\u0644\u0649 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0634\u062d\u0646\u060c \u0623\u0648 \u0634\u062d\u0646 \u0645\u062c\u0627\u0646\u064a<\/li>\n<\/ul>\n<ol>\n<li><strong>\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642: \u0643\u064a\u0641 \u064a\u062d\u0635\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u062e\u0635\u0645\u061f<\/strong><\/li>\n<\/ol>\n<ul>\n<li>\u0643\u0648\u062f \u062e\u0635\u0645 (\u064a\u062f\u0648\u064a): \u064a\u064f\u062f\u062e\u0644\u0647 \u0627\u0644\u0639\u0645\u064a\u0644 \u0639\u0646\u062f \u0627\u0644\u0634\u0631\u0627\u0621<\/li>\n<li>\u062e\u0635\u0645 \u062a\u0644\u0642\u0627\u0626\u064a: \u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0645\u0628\u0627\u0634\u0631\u0629 \u0641\u064a \u0627\u0644\u0633\u0644\u0629 \u0639\u0646\u062f \u062a\u062d\u0642\u0642 \u0627\u0644\u0634\u0631\u0648\u0637<\/li>\n<\/ul>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"wp-image-12703 aligncenter\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-122803.png\" alt=\"\" width=\"607\" height=\"356\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-122803.png 1130w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-122803-300x176.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-122803-1024x601.png 1024w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/Screenshot-2026-05-20-122803-768x451.png 768w\" sizes=\"auto, (max-width: 607px) 100vw, 607px\" \/><\/p>\n<h5>\u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u0639\u0627\u062f\u064a<\/h5>\n<p><strong>\u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u0623\u0643\u062b\u0631 \u0634\u064a\u0648\u0639\u064b\u0627. \u062a\u0642\u062f\u0645 \u0641\u064a\u0647:<\/strong><\/p>\n<ul>\n<li>\u0646\u0633\u0628\u0629 \u0645\u0626\u0648\u064a\u0629 (\u0645\u062b\u0627\u0644: 15% \u062e\u0635\u0645)<\/li>\n<li>\u0645\u0628\u0644\u063a \u062b\u0627\u0628\u062a (\u0645\u062b\u0627\u0644: 50 \u0631\u064a\u0627\u0644 \u062e\u0635\u0645)<\/li>\n<\/ul>\n<p><strong>\u064a\u0645\u0643\u0646 \u062a\u0637\u0628\u064a\u0642\u0647 \u0639\u0644\u0649:<\/strong><\/p>\n<ul>\n<li>\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0637\u0644\u0628<\/li>\n<li>\u0645\u0646\u062a\u062c\u0627\u062a \u0645\u0639\u064a\u0651\u0646\u0629 \u0623\u0648 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u0639\u064a\u0651\u0646\u0629<\/li>\n<li>\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0639\u0645\u0644\u0627\u0621 \u0645\u0639\u064a\u0651\u0646\u0629 (\u0645\u062b\u0627\u0644: \u0639\u0645\u0644\u0627\u0621 VIP)<\/li>\n<\/ul>\n<h5>\u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0645\u062c\u0627\u0646\u064a<\/h5>\n<p>\u0639\u0631\u0636 \u0645\u062a\u062e\u0635\u0635 \u064a\u0644\u063a\u064a \u0631\u0633\u0648\u0645 \u0627\u0644\u0634\u062d\u0646\u060c \u0645\u0646\u0627\u0633\u0628 \u062c\u062f\u064b\u0627 \u0644\u0631\u0641\u0639 \u0645\u0639\u062f\u0644 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u062a\u062e\u0644\u064a \u0639\u0646 \u0627\u0644\u0633\u0644\u0629.<\/p>\n<p><strong>\u064a\u0645\u0643\u0646 \u0631\u0628\u0637\u0647 \u0628\u0634\u0631\u0648\u0637 \u0645\u062b\u0644:<\/strong><\/p>\n<ul>\n<li>\u00a0\u062d\u062f \u0623\u062f\u0646\u0649 \u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0633\u0644\u0629 (\u0645\u062b\u0627\u0644: \u0634\u062d\u0646 \u0645\u062c\u0627\u0646\u064a \u0641\u0648\u0642 150 \u0631\u064a\u0627\u0644)<\/li>\n<li>\u00a0\u0645\u0648\u0627\u0642\u0639 \u062c\u063a\u0631\u0627\u0641\u064a\u0629 \u0645\u062d\u062f\u062f\u0629<\/li>\n<li>\u00a0\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0639\u0645\u0644\u0627\u0621 \u0645\u0639\u064a\u0651\u0646\u0629<\/li>\n<\/ul>\n<h5>\u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u062a\u0635\u0627\u0639\u062f\u064a<\/h5>\n<p>\u062e\u0635\u0645 \u0645\u062a\u062f\u0631\u062c \u064a\u0643\u0628\u0631 \u0643\u0644\u0645\u0627 \u0632\u0627\u062f\u062a \u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0644\u0639\u0645\u064a\u0644\u060c \u0625\u0645\u0627 \u0628\u0642\u064a\u0645\u0629 \u0627\u0644\u0633\u0644\u0629 \u0623\u0648 \u0628\u0639\u062f\u062f \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a. \u064a\u0633\u0627\u0639\u062f \u0639\u0644\u0649 \u0631\u0641\u0639 \u0645\u062a\u0648\u0633\u0637 \u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628.<\/p>\n<p><strong>\u0645\u062b\u0627\u0644:<\/strong><\/p>\n<ul>\n<li>1,000 \u0631\u064a\u0627\u0644 \u2190 \u062e\u0635\u0645 10%<\/li>\n<li>3,000 \u0631\u064a\u0627\u0644 \u2190 \u062e\u0635\u0645 15%<\/li>\n<li>5,000 \u0631\u064a\u0627\u0644 \u2190 \u062e\u0635\u0645 20%<\/li>\n<\/ul>\n<hr \/>\n<div id=\"index3\"><\/div>\n<h5>\u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a<\/h5>\n<p><strong>\u0644\u064a\u0633\u062a \u0643\u0644 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062f\u0645\u062c. \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629:<\/strong><\/p>\n<p><img loading=\"lazy\" decoding=\"async\" class=\"alignnone size-full wp-image-12609\" src=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/\u0644\u0642\u0637\u0629-\u0634\u0627\u0634\u0629-2026-05-17-133948.png\" alt=\"\" width=\"1025\" height=\"260\" title=\"\" srcset=\"https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/\u0644\u0642\u0637\u0629-\u0634\u0627\u0634\u0629-2026-05-17-133948.png 1025w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/\u0644\u0642\u0637\u0629-\u0634\u0627\u0634\u0629-2026-05-17-133948-300x76.png 300w, https:\/\/help.zid.sa\/wp-content\/uploads\/2026\/05\/\u0644\u0642\u0637\u0629-\u0634\u0627\u0634\u0629-2026-05-17-133948-768x195.png 768w\" sizes=\"auto, (max-width: 1025px) 100vw, 1025px\" \/><\/p>\n<hr \/>\n<div id=\"index4\"><\/div>\n<h5>\u0646\u0635\u0627\u0626\u062d \u0648\u0623\u0641\u0636\u0644 \u0627\u0644\u0645\u0645\u0627\u0631\u0633\u0627\u062a<\/h5>\n<ul>\n<li>\u0627\u0633\u062a\u062e\u062f\u0645 \u062a\u062a\u0628\u0639 \u0627\u0644\u0623\u062f\u0627\u0621 \u0642\u0628\u0644 \u0627\u0644\u062a\u0648\u0633\u0639: \u0634\u063a\u0651\u0644 \u0627\u0644\u062d\u0645\u0644\u0629 \u0639\u0644\u0649 \u0646\u0637\u0627\u0642 \u0635\u063a\u064a\u0631\u060c \u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0624\u0634\u0631\u0627\u062a\u060c \u062b\u0645 \u0648\u0633\u0651\u0639\u0647\u0627<\/li>\n<li>\u00a0\u0627\u062e\u062a\u0631 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0647\u062f\u0641\u0643: \u0643\u0648\u062f \u064a\u062f\u0648\u064a \u0644\u0644\u062d\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0651\u0647\u0629 (\u0628\u0631\u064a\u062f\u060c \u0645\u0624\u062b\u0651\u0631\u064a\u0646)\u060c \u0648\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0644\u062d\u0645\u0644\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0632\u064a\u0627\u062f\u0629 \u0645\u0639\u062f\u0644 \u0627\u0644\u062a\u062d\u0648\u064a\u0644<\/li>\n<li>\u00a0\u0627\u0631\u0628\u0637 \u0627\u0644\u062e\u0635\u0645 \u0628\u0627\u0644\u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629: \u062e\u0635\u0645 \u062a\u0635\u0627\u0639\u062f\u064a \u0644\u0631\u0641\u0639 AOV\u060c \u0634\u062d\u0646 \u0645\u062c\u0627\u0646\u064a \u0644\u062a\u0642\u0644\u064a\u0644 \u0627\u0644\u062a\u062e\u0644\u064a \u0639\u0646 \u0627\u0644\u0633\u0644\u0629\u060c \u0623\u0643\u0648\u0627\u062f \u0645\u062a\u0639\u062f\u062f\u0629 \u0644\u0642\u064a\u0627\u0633 \u0642\u0646\u0648\u0627\u062a \u0627\u0644\u062a\u0633\u0648\u064a\u0642<\/li>\n<li>\u00a0\u0627\u0633\u062a\u0641\u062f \u0645\u0646 \u062e\u0627\u0635\u064a\u0629 &#8220;\u062a\u0643\u0631\u0627\u0631&#8221;: \u0639\u0646\u062f \u0625\u0639\u0627\u062f\u0629 \u062a\u0634\u063a\u064a\u0644 \u062d\u0645\u0644\u0629 \u0645\u0648\u0633\u0645\u064a\u0629\u060c \u0643\u0631\u0651\u0631 \u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u0642\u062f\u064a\u0645 \u0628\u062f\u0644 \u0625\u0646\u0634\u0627\u0626\u0647 \u0645\u0646 \u0627\u0644\u0635\u0641\u0631<\/li>\n<li>\u00a0\u062a\u062c\u0646\u0651\u0628 \u062a\u0634\u063a\u064a\u0644 \u062e\u0635\u0648\u0645\u0627\u062a \u0645\u062a\u0639\u0627\u0631\u0636\u0629 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0641\u062a\u0631\u0629: \u0633\u064a\u064f\u0631\u0628\u0643 \u0630\u0644\u0643 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0648\u0642\u062f \u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u062e\u0635\u0645 \u0644\u0645 \u062a\u0643\u0646 \u062a\u0646\u0648\u064a \u062a\u0642\u062f\u064a\u0645\u0647<\/li>\n<\/ul>\n<hr \/>\n<div id=\"index5\"><\/div>\n<h5>\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629<\/h5>\n<p><strong>\u0647\u0644 \u064a\u0645\u0643\u0646\u0646\u064a \u062a\u0639\u062f\u064a\u0644 \u0623\u0643\u062b\u0631 \u0645\u0646 \u062e\u0635\u0645 \u0628\u0639\u062f \u0625\u0646\u0634\u0627\u0626\u0647\u0645\u061f<\/strong><\/p>\n<p>\u0646\u0639\u0645\u060c \u062d\u062f\u0651\u062f \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062f \u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0648\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0632\u0631 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u062c\u0645\u0651\u0639\u060c \u0648\u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0641\u064a \u0623\u064a \u0648\u0642\u062a.<\/p>\n<p><strong>\u0643\u064a\u0641 \u0623\u0643\u0631\u0631 \u062e\u0635\u0645 \u0645\u0648\u062c\u0648\u062f \u0645\u0633\u0628\u0642\u0627 \u0628\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0634\u0627\u0628\u0647\u0629\u061f<\/strong><\/p>\n<p>\u0645\u0646 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 \u0627\u0636\u063a\u0637 (\u22ee) \u2190 \u062a\u0643\u0631\u0627\u0631. \u0633\u062a\u064f\u0646\u0634\u0623 \u0646\u0633\u062e\u0629 \u062c\u062f\u064a\u062f\u0629 \u0628\u0646\u0641\u0633 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0639\u062f\u0651\u0644 \u0645\u0627 \u062a\u0634\u0627\u0621 \u0648\u0627\u062d\u0641\u0638.<\/p>\n<p><strong>\u0647\u0644 \u062a\u0646\u0637\u0628\u0642 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a \u0639\u0644\u0649 \u062c\u0645\u064a\u0639 \u0628\u0627\u0642\u0627\u062a \u0632\u062f\u061f<\/strong><\/p>\n<p>\u0646\u0639\u0645\u060c \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0645\u062a\u0627\u062d\u0629 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u0627\u0642\u0627\u062a. \u0628\u0639\u0636 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629 (\u0645\u062b\u0644 \u0627\u0644\u0623\u0643\u0648\u0627\u062f \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629) \u0642\u062f \u062a\u0631\u062a\u0628\u0637 \u0628\u0634\u0631\u0648\u0637 \u0645\u062d\u062f\u062f\u0629\u060c \u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0642\u0627\u0644 \u0627\u0644\u0645\u062e\u0635\u0635 \u0644\u0643\u0644 \u0646\u0648\u0639.<\/p>\n<p><strong>\u0643\u064a\u0641 \u0623\u062a\u062a\u0628\u0639 \u0623\u062f\u0627\u0621 \u0643\u0644 \u0642\u0646\u0627\u0629 \u062a\u0633\u0648\u064a\u0642\u064a\u0629 \u0628\u0634\u0643\u0644 \u0645\u0646\u0641\u0635\u0644\u061f<\/strong><\/p>\n<p>\u0623\u0646\u0634\u0626 \u0639\u0631\u0648\u0636\u064b\u0627 \u0645\u062a\u0646\u0648\u0639\u0629 \u0628\u0643\u0648\u062f \u0645\u062e\u062a\u0644\u0641 \u0644\u0643\u0644 \u0642\u0646\u0627\u0629 (\u0625\u0646\u0633\u062a\u0642\u0631\u0627\u0645\u060c \u0627\u0644\u0625\u064a\u0645\u064a\u0644\u060c \u0627\u0644\u0645\u0624\u062b\u0631). \u0643\u0644 \u0643\u0648\u062f \u0644\u0647 \u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0645\u0633\u062a\u0642\u0644\u0629.<\/p>\n<p><strong>\u0645\u0627\u0630\u0627 \u064a\u062d\u062f\u062b \u0625\u0630\u0627 \u0623\u0631\u0627\u062f \u0627\u0644\u0639\u0645\u064a\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0643\u0648\u062f \u0645\u0639 \u0648\u062c\u0648\u062f \u062e\u0635\u0645 \u062a\u0644\u0642\u0627\u0626\u064a\u061f<\/strong><\/p>\n<p>\u0644\u0646 \u064a\u062c\u062a\u0645\u0639\u0627. \u0633\u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0623\u062d\u062f\u0647\u0645\u0627 \u0641\u0642\u0637\u060c \u0625\u0645\u0627 \u0627\u0644\u0643\u0648\u062f \u0627\u0644\u0630\u064a \u0623\u062f\u062e\u0644\u0647 \u0627\u0644\u0639\u0645\u064a\u0644 \u0623\u0648 \u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u062d\u0633\u0628 \u0646\u0648\u0639\u0647.<\/p>\n","protected":false},"excerpt":{"rendered":"<p>\u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a \u0647\u064a \u0623\u062f\u0627\u062a\u0643 \u0627\u0644\u0623\u0642\u0648\u0649 \u0644\u0644\u062a\u0631\u0648\u064a\u062c: \u062a\u0631\u0641\u0639 \u0627\u0644\u0645\u0628\u064a\u0639\u0627\u062a\u060c \u062a\u0634\u062c\u0639 \u0627\u0644\u0639\u0645\u0644\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0627\u0621\u060c \u0648\u062a\u0632\u064a\u062f \u0645\u062a\u0648\u0633\u0637 \u0642\u064a\u0645\u0629 \u0627\u0644\u0637\u0644\u0628. \u062a\u0648\u0641\u0631 \u0644\u0643 \u0632\u062f \u0646\u0638\u0627\u0645 \u0645\u0631\u0646 \u064a\u062f\u0639\u0645 \u0623\u0646\u0648\u0627\u0639 \u0645\u062a\u0639\u062f\u062f\u0629 \u0645\u0646 \u0627\u0644\u062e\u0635\u0648\u0645\u0627\u062a\u060c \u0645\u0646 \u0643\u0648\u0628\u0648\u0646 \u0628\u0633\u064a\u0637\u060c \u062e\u0635\u0645 \u064a\u0637\u0628\u0642 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627\u060c \u062e\u0635\u0648\u0645\u0627\u062a \u062a\u0635\u0627\u0639\u062f\u064a\u0629 \u0645\u0639\u0642\u062f\u0629\u060c \u0625\u0644\u0649 \u0623\u0643\u0648\u0627\u062f \u0645\u062a\u0639\u062f\u062f\u0629 \u0644\u0634\u0631\u0643\u0627\u0621 \u0627\u0644\u062a\u0633\u0648\u064a\u0642 \u0628\u0627\u0644\u0639\u0645\u0648\u0644\u0629.<span class=\"ellipsis\">&hellip;<\/span> <a href=\"https:\/\/help.zid.sa\/discount-management\/\"><\/p>\n<div class=\"read-more\">Read more &#8250;<\/div>\n<p><!-- end of .read-more --><\/a><\/p>\n","protected":false},"author":10,"featured_media":0,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"inline_featured_image":false,"_lmt_disableupdate":"no","_lmt_disable":"no","_glsr_average":5,"_glsr_ranking":3.6363636363636,"_glsr_reviews":1,"footnotes":""},"categories":[81,1807],"tags":[],"class_list":["post-12590","post","type-post","status-publish","format-standard","hentry","category-81","category-discounts"],"acf":{"banner_title_ar":"\u062e\u0635\u0648\u0645\u0627\u062a \u0645\u0631\u0646\u0629 \u062a\u0633\u0627\u0639\u062f\u0643 \u0639\u0644\u0649 \u062c\u0630\u0628 \u0627\u0644\u0639\u0645\u0644\u0627\u0621","banner_title_en":"Flexible discounts that help you attract customers","banner_subtitle_ar":"\u062d\u0641\u0651\u0632 \u0639\u0645\u0644\u0627\u0621\u0643 \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0627\u0621 \u0648\u0627\u0644\u0639\u0648\u062f\u0629 \u0645\u062c\u062f\u062f\u064b\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0