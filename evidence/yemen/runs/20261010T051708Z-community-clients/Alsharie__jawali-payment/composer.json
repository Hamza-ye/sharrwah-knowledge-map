{
    "name": "alsharie/jawali-payment",
    "version": "1.0.0",
    "description": "Laravel package to integrate with Jawali APIs.",
    "type": "laravel-package",
    "license": "MIT",
    "author": "Abdulrahman alsharie",
    "require": {
        "php": ">=7.4",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Alsharie\\Jawali\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alsharie\\Jawali\\JawaliServiceProvider"
            ],
            "aliases": {
                "Jawali": "Alsharie\\Jawali\\Facades\\Jawali"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}